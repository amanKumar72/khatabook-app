{
  "expo": {
    "name": "Khatabook",
    "slug": "khatabook-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "khatabookapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.khatabook.offline",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Khatabook to use Face ID to protect your business ledger."
      }
    },
    "android": {
      "package": "com.khatabook.offline",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Khatabook to use Face ID to protect your business ledger."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Khatabook to access camera for scanning UPI QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Khatabook to access photos for receipt attachments."
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e1993fa8-4c7c-400b-8edf-c1337ac49125"
      }
    }
  }
}
